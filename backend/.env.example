PORT=5000
NODE_ENV=production

# Preferred single URI for production
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/irfwardrobe?retryWrites=true&w=majority
MONGODB_DB_NAME=irfwardrobe

# Optional local/remote fallback mode
USE_REMOTE=true
MONGODB_URI_LOCAL=mongodb://localhost:27017/irfwardrobe
MONGODB_URI_REMOTE=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/irfwardrobe?retryWrites=true&w=majority

JWT_SECRET=replace_with_long_random_secret

# Contact form email delivery
CONTACT_RECEIVER_EMAIL=irfwardrobe@gmail.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
# SMTP_SECURE supported values:
# false -> plain/auto STARTTLS (recommended with port 587)
# true  -> implicit TLS (recommended with port 465)
# tls   -> explicit STARTTLS (works with port 587)
SMTP_SECURE=false
SMTP_USER=irfwardrobe@gmail.com
SMTP_PASS=replace_with_email_password
SMTP_FROM_EMAIL=irfwardrobe@gmail.com

# Optional absolute path for uploaded product images (recommended outside project folder)
# If empty, default is auto-used from code:
#   Windows: C:/Users/<user>/irfwardrobe-uploads
#   Linux: /home/<user>/irfwardrobe-uploads
# Example custom (Windows): C:/irfwardrobe-data/uploads
# Example custom (Linux): /var/lib/irfwardrobe/uploads
UPLOADS_DIR=

# Comma-separated frontend origins that can call the API
CORS_ORIGINS=https://irfwardrobe.com,https://www.irfwardrobe.com
